      "typeVersion": 4.2,
      "position": [
        30,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Groq Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const previous = $('Capture Generated Code').item.json;\nconst critique = $json.choices?.[0]?.message?.content?.trim() ?? '';\nconst approved = critique.toUpperCase().includes('APPROVED');\nconst critiques = [...(previous.critiques ?? []), approved ? 'APPROVED' : critique];\nreturn [{ json: { ...previous, last_critique: critique, critiques, approved, round_count: previous.round_count + 1 } }];"
      },
