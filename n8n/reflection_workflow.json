    {
      "parameters": {
        "jsCode": "const incoming = $json.body ?? $json;\nconst task = String(incoming.task ?? '').trim();\nif (!task) {\n  throw new Error('task field is required');\n}\nconst maxRounds = Math.min(Math.max(Number(incoming.max_rounds ?? 3), 1), 3);\nreturn [{ json: { task, max_rounds: maxRounds, round_count: 0, approved: false, code: '', last_critique: '', critiques: [] } }];"
      },
      "id": "78258ce5-593d-4e83-9799-dd719e0a7be1",
      "name": "Round State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama-3.1-8b-instant', messages: [ { role: 'system', content: 'You are an expert Python developer. Write clean, safe Python functions for NLP and text-processing tasks. Include a docstring. Handle edge cases. Return ONLY Python code, no markdown fences.' }, { role: 'user', content: $json.round_count === 0 ? `Write a Python function for this NLP/text-processing task:\\n${$json.task}` : `You are revising your previous Python function.\\n\\nOriginal task:\\n${$json.task}\\n\\nPrevious code:\\n${$json.code}\\n\\nCritique received:\\n${$json.last_critique}\\n\\nRewrite the function to fix every issue. Return ONLY corrected Python code.` } ], temperature: 0.3, max_tokens: 1024 } }}",
        "options": {}
      },
      "id": "668c21a6-aa28-40af-8948-d0fd433fd27f",
      "name": "Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -470,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Groq Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let state;\ntry {\n  state = $('Check Max Rounds').item.json;\n} catch (error) {\n  state = $('Round State').item.json;\n}\nconst generated = $json.choices?.[0]?.message?.content?.trim() ?? '';\nconst code = generated.replace(/^```(?:python)?\\s*/i, '').replace(/```$/i, '').trim();\nreturn [{ json: { ...state, code } }];"
      },
      "id": "7edbafef-0670-49d6-9ab1-2379428dc30d",
      "name": "Capture Generated Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama-3.1-8b-instant', messages: [ { role: 'system', content: 'You are a senior Python reviewer for NLP/text-processing code. Review against exactly these five criteria: 1. Unicode and encoding handling. 2. Performance on large inputs. 3. Clear output schema. 4. Language-agnostic assumptions. 5. Error handling for malformed input. For every problem write ISSUE [criterion]: specific problem and why it matters. If all five are satisfied, respond with exactly APPROVED. Never approve if any issue remains.' }, { role: 'user', content: `Review this Python code for the NLP/text-processing task:\\n\\nTask:\\n${$json.task}\\n\\nCode:\\n${$json.code}` } ], temperature: 0.3, max_tokens: 1024 } }}",
        "options": {}
      },
      "id": "1c4d3866-5be5-40ac-8fc9-124ebc0776a0",
      "name": "Critic - NLP Checklist",
